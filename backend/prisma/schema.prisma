generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  ADMIN
  BASE_COMMANDER
  LOGISTICS_OFFICER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

enum EquipmentCategory {
  WEAPON
  VEHICLE
  AMMUNITION
  COMMUNICATION
  MEDICAL
  OTHER
}

enum Unit {
  NOS
  ROUNDS
  BOXES
  LITRES
  KGS
  METRES
}

enum MovementType {
  INITIAL_STOCK
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ASSIGNMENT
  ASSIGNMENT_RETURN
  EXPENDITURE
}

enum ReferenceType {
  INITIAL_STOCK
  PURCHASE
  TRANSFER
  ASSIGNMENT
  ASSIGNMENT_RETURN
  EXPENDITURE
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum AssetMovementType {
  ASSIGNMENT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  MAINTENANCE_START
  MAINTENANCE_COMPLETE
  PROCUREMENT
  DISPOSAL
}

enum MovementReferenceType {
  ASSIGNMENT
  TRANSFER
  MAINTENANCE
  PROCUREMENT
  DISPOSAL
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  UNSERVICEABLE
}

//
// MODELS
//

model Base {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  location String
  isActive Boolean @default(true)

  users             User[]
  inventories       Inventory[]
  equipmentAssets   EquipmentAsset[]
  ledgers           Ledger[]
  outgoingMovements MovementHistory[] @relation("SourceMovements")
  incomingMovements MovementHistory[] @relation("DestinationMovements")
  procurements      Procurement[]

  purchases     Purchase[]
  assignments   Assignment[]
  expenditures  Expenditure[]

  outgoingTransfers Transfer[] @relation("FromBase")
  incomingTransfers Transfer[] @relation("ToBase")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role   Role
  status UserStatus @default(ACTIVE)

  baseId String?
  base   Base? @relation(fields: [baseId], references: [id])

  ledgers       Ledger[]
  auditLogs     AuditLog[]
  notifications Notification[]
  attachments   Attachment[]
  inspections   Inspection[]
  reportRequests ReportJob[]      @relation("ReportRequests")

  purchases             Purchase[]
  transfers             Transfer[]
  assignments           Assignment[]
  returnedAssignments   Assignment[]      @relation("ReturnedAssignments")
  expenditures          Expenditure[]
  movements             MovementHistory[]
  createdMaintenances   Maintenance[]     @relation("CreatedMaintenance")
  completedMaintenances Maintenance[]     @relation("CompletedMaintenance")
  procurements          Procurement[]
  approvedDisposals     Disposal[]        @relation("ApprovedDisposals")
  performedDisposals    Disposal[]        @relation("DisposedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseId])
}

model Equipment {
  id                String            @id @default(cuid())
  name              String
  category          EquipmentCategory
  unit              Unit
  description       String?
  manufacturer      String?
  model             String?
  specifications    String?
  expectedLifeYears Int?
  isActive          Boolean           @default(true)

  assets      EquipmentAsset[]
  inventories Inventory[]

  purchases    Purchase[]
  procurementItems ProcurementItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model EquipmentAsset {
  id           String             @id @default(cuid())
  equipmentId  String
  equipment    Equipment          @relation(fields: [equipmentId], references: [id])
  baseId       String
  base         Base               @relation(fields: [baseId], references: [id])
  serialNumber String             @unique
  purchaseDate DateTime?
  purchaseCost Decimal
  status       EquipmentStatus    @default(AVAILABLE)
  condition    EquipmentCondition @default(NEW)
  remarks      String?
  isActive     Boolean            @default(true)
  qrCodeUrl    String?
  unitId       String?
  unit         OrganizationUnit?  @relation(fields: [unitId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  transfers           Transfer[]
  assignments         Assignment[]
  expenditures        Expenditure[]
  ledgers             Ledger[]
  movements           MovementHistory[]
  maintenances        Maintenance[]
  disposals           Disposal[]
  warranties          Warranty[]
  valuation           AssetValuation?
  inspections         Inspection[]
  depreciationHistory DepreciationHistory[]

  @@index([equipmentId])
  @@index([baseId])
  @@index([status])
  @@index([isActive])
  @@index([unitId])
}

model Inventory {
  id String @id @default(cuid())

  baseId String
  base   Base   @relation(fields: [baseId], references: [id])

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  quantity            Int     @default(0)
  availableQuantity   Int     @default(0)
  allocatedQuantity   Int     @default(0)
  inTransitQuantity   Int     @default(0)
  maintenanceQuantity Int     @default(0)
  damagedQuantity     Int     @default(0)
  minimumStock        Int     @default(0)
  remarks             String?
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipmentId, baseId])
  @@index([equipmentId])
  @@index([baseId])
  @@index([isActive])
}

model Purchase {
  id String @id @default(cuid())

  baseId String
  base Base @relation(fields: [baseId], references: [id])

  equipmentId String
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  quantity Int

  vendor String?

  purchasedById String
  purchasedBy User @relation(fields: [purchasedById], references: [id])

  remarks String?

  ledgers Ledger[]

  purchasedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseId])
  @@index([equipmentId])
  @@index([purchasedAt])
  @@index([purchasedById])
}

model Transfer {
  id String @id @default(cuid())

  equipmentAssetId String
  equipmentAsset   EquipmentAsset @relation(fields: [equipmentAssetId], references: [id])

  fromBaseId String
  fromBase Base @relation("FromBase", fields: [fromBaseId], references: [id])

  toBaseId String
  toBase Base @relation("ToBase", fields: [toBaseId], references: [id])

  quantity Int

  transferredById String
  transferredBy User @relation(fields: [transferredById], references: [id])

  remarks String?
  status  TransferStatus @default(PENDING)

  ledgers Ledger[]

  transferredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBaseId])
  @@index([toBaseId])
  @@index([equipmentAssetId])
  @@index([transferredById])
}

model Assignment {
  id String @id @default(cuid())

  baseId String
  base Base @relation(fields: [baseId], references: [id])

  equipmentAssetId String
  equipmentAsset   EquipmentAsset @relation(fields: [equipmentAssetId], references: [id])

  assignedTo String
  personnelId String?
  personnel   Personnel? @relation(fields: [personnelId], references: [id])

  status           AssignmentStatus @default(ACTIVE)

  assignedById String
  assignedBy User @relation(fields: [assignedById], references: [id])

  returnedAt DateTime?
  returnedById String?
  returnedBy User? @relation("ReturnedAssignments", fields: [returnedById], references: [id])

  remarks String?

  ledgers Ledger[]

  assignedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseId])
  @@index([equipmentAssetId])
  @@index([assignedById])
  @@index([returnedById])
  @@index([personnelId])
}

model Expenditure {
  id String @id @default(cuid())

  baseId String
  base Base @relation(fields: [baseId], references: [id])

  equipmentAssetId String
  equipmentAsset   EquipmentAsset @relation(fields: [equipmentAssetId], references: [id])

  quantity Int

  reason String

  expendedById String
  expendedBy User @relation(fields: [expendedById], references: [id])

  remarks String?

  ledgers Ledger[]

  expendedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseId])
  @@index([equipmentAssetId])
  @@index([expendedById])
}

model Ledger {
  id String @id @default(cuid())

  baseId String
  base Base @relation(fields: [baseId], references: [id])

  equipmentAssetId String
  equipmentAsset   EquipmentAsset @relation(fields: [equipmentAssetId], references: [id])

  movementType MovementType

  quantity Int

  referenceType ReferenceType

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  transferId String?
  transfer   Transfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  expenditureId String?
  expenditure   Expenditure? @relation(fields: [expenditureId], references: [id], onDelete: Restrict)

  createdById String
  createdBy User @relation(fields: [createdById], references: [id])

  remarks String?

  createdAt DateTime @default(now())

  @@index([baseId])
  @@index([equipmentAssetId])
  @@index([movementType])
  @@index([createdAt])
  @@index([baseId, equipmentAssetId, createdAt])
  @@index([baseId, createdAt])
  @@index([purchaseId])
  @@index([transferId])
  @@index([assignmentId])
  @@index([expenditureId])
  @@index([createdById])
}

model AuditLog {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  performedByType PerformedByType @default(USER)
  module          String
  action          String
  entityType      String
  entityId        String
  result          AuditResult     @default(SUCCESS)
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model MovementHistory {
  id                 String                @id @default(cuid())
  equipmentAssetId   String
  equipmentAsset     EquipmentAsset        @relation(fields: [equipmentAssetId], references: [id])
  movementType       AssetMovementType
  sourceBaseId       String?
  sourceBase         Base?                 @relation("SourceMovements", fields: [sourceBaseId], references: [id])
  destinationBaseId  String?
  destinationBase    Base?                 @relation("DestinationMovements", fields: [destinationBaseId], references: [id])
  referenceType      MovementReferenceType
  referenceId        String
  performedById      String
  performedBy        User                  @relation(fields: [performedById], references: [id])
  remarks            String?
  createdAt          DateTime              @default(now())

  @@index([equipmentAssetId])
  @@index([sourceBaseId])
  @@index([destinationBaseId])
  @@index([performedById])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([equipmentAssetId, createdAt])
  @@index([createdAt])
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  CALIBRATION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProcurementStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum DisposalReason {
  RETIRED
  DAMAGED
  LOST
  DESTROYED
  SOLD
  SCRAPPED
}

enum DisposalStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

model Maintenance {
  id                     String            @id @default(cuid())
  equipmentAssetId       String
  equipmentAsset         EquipmentAsset    @relation(fields: [equipmentAssetId], references: [id])
  maintenanceType        MaintenanceType
  status                 MaintenanceStatus @default(SCHEDULED)
  description            String
  scheduledDate          DateTime
  expectedCompletionDate DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  vendorName             String?
  technicianName         String?
  estimatedCost          Decimal?
  actualCost             Decimal?
  remarks                String?
  createdById            String
  createdBy              User              @relation("CreatedMaintenance", fields: [createdById], references: [id])
  completedById          String?
  completedBy            User?             @relation("CompletedMaintenance", fields: [completedById], references: [id])
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([equipmentAssetId])
  @@index([status])
  @@index([maintenanceType])
  @@index([createdById])
  @@index([completedById])
  @@index([isActive])
}

model Procurement {
  id                   String            @id @default(cuid())
  procurementNumber    String            @unique
  supplier             String
  supplierId           String?
  supplierRef          Supplier?         @relation(fields: [supplierId], references: [id])
  status               ProcurementStatus @default(DRAFT)
  purchaseDate         DateTime
  expectedDeliveryDate DateTime
  receivedDate         DateTime?
  totalCost            Decimal           @default(0)
  remarks              String?
  baseId               String
  base                 Base              @relation(fields: [baseId], references: [id])
  createdById          String
  createdBy            User              @relation(fields: [createdById], references: [id])
  items                ProcurementItem[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([baseId])
  @@index([status])
  @@index([supplierId])
}

model ProcurementItem {
  id               String      @id @default(cuid())
  procurementId    String
  procurement      Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  equipmentId      String
  equipment        Equipment   @relation(fields: [equipmentId], references: [id])
  quantity         Int
  receivedQuantity Int         @default(0)
  unitCost         Decimal

  @@index([procurementId])
  @@index([equipmentId])
}

model Disposal {
  id               String         @id @default(cuid())
  equipmentAssetId String
  equipmentAsset   EquipmentAsset @relation(fields: [equipmentAssetId], references: [id])
  disposalReason   DisposalReason
  status           DisposalStatus @default(PENDING)
  remarks          String?
  approvedById     String?
  approvedBy       User?          @relation("ApprovedDisposals", fields: [approvedById], references: [id])
  disposedById     String?
  disposedBy       User?          @relation("DisposedBy", fields: [disposedById], references: [id])
  disposalDate     DateTime?
  bookValue        Decimal?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([equipmentAssetId])
  @@index([status])
  @@index([disposalReason])
  @@index([approvedById])
  @@index([disposedById])
}

enum PerformedByType {
  USER
  SYSTEM
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum NotificationType {
  MAINTENANCE
  PROCUREMENT
  TRANSFER
  ASSIGNMENT
  DISPOSAL
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Notification {
  id        String               @id @default(cuid())
  userId    String?
  user      User?                @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  priority  NotificationPriority @default(LOW)
  isRead    Boolean              @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime             @default(now())
  readAt    DateTime?
  expiresAt DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

enum OrgLevel {
  COMMAND
  DIVISION
  BRIGADE
  BATTALION
  COMPANY
  PLATOON
  SECTION
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PersonnelStatus {
  ACTIVE
  INACTIVE
  DEPLOYED
  ON_LEAVE
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOIDED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DOUBLE_DECLINING
}

enum ReportJobStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

// 1. Military Organizational Unit (Hierarchy)
model OrganizationUnit {
  id              String             @id @default(cuid())
  name            String
  code            String             @unique
  level           OrgLevel
  parentId        String?
  parent          OrganizationUnit?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children        OrganizationUnit[] @relation("OrgHierarchy")
  personnel       Personnel[]
  equipmentAssets EquipmentAsset[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([parentId])
  @@index([level])
}

// 2. Personnel Module
model Personnel {
  id            String             @id @default(cuid())
  serviceNumber String             @unique
  rank          String
  firstName     String
  lastName      String
  unitId        String?
  unit          OrganizationUnit?  @relation(fields: [unitId], references: [id])
  email         String?
  phone         String?
  status        PersonnelStatus    @default(ACTIVE)
  assignments   Assignment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([unitId])
  @@index([status])
  @@index([serviceNumber])
}

// 3. Supplier Management
model Supplier {
  id           String         @id @default(cuid())
  name         String
  code         String         @unique
  contactName  String?
  email        String?
  phone        String?
  address      String?
  status       SupplierStatus @default(ACTIVE)
  isActive     Boolean        @default(true)
  procurements Procurement[]
  warranties   Warranty[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
}

// 4. File & Document Attachments
model Attachment {
  id           String    @id @default(cuid())
  filename     String
  mimeType     String
  fileSize     Int
  storageKey   String    @unique
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  entityType   String    // "PROCUREMENT", "MAINTENANCE", "DISPOSAL", "EQUIPMENT_ASSET", "INSPECTION"
  entityId     String
  version      Int       @default(1)
  isLatest     Boolean   @default(true)
  metadata     Json?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([isActive])
}

// 5. Warranty Tracking
model Warranty {
  id               String          @id @default(cuid())
  equipmentAssetId String          
  equipmentAsset   EquipmentAsset  @relation(fields: [equipmentAssetId], references: [id])
  startDate        DateTime
  endDate          DateTime
  vendorId         String?
  vendor           Supplier?       @relation(fields: [vendorId], references: [id])
  coverageDetails  String?
  status           WarrantyStatus  @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([equipmentAssetId])
  @@index([endDate])
  @@index([status])
}

// 6. Inspection Workflows
model Inspection {
  id               String           @id @default(cuid())
  equipmentAssetId String
  equipmentAsset   EquipmentAsset   @relation(fields: [equipmentAssetId], references: [id])
  scheduledDate    DateTime
  completedDate    DateTime?
  inspectorId      String
  inspector        User             @relation(fields: [inspectorId], references: [id])
  result           InspectionResult @default(PENDING)
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([equipmentAssetId])
  @@index([result])
  @@index([scheduledDate])
}

// 7. Depreciation & Valuation
model AssetValuation {
  id                 String             @id @default(cuid())
  equipmentAssetId   String             @unique
  equipmentAsset     EquipmentAsset     @relation(fields: [equipmentAssetId], references: [id])
  purchaseValue      Decimal
  currentValue       Decimal
  bookValue          Decimal
  residualValue      Decimal
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  depreciationRate   Decimal
  lastCalculatedAt   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model DepreciationHistory {
  id                String   @id @default(cuid())
  equipmentAssetId  String
  equipmentAsset    EquipmentAsset @relation(fields: [equipmentAssetId], references: [id])
  date              DateTime
  amount            Decimal
  previousBookValue Decimal
  newBookValue      Decimal
  createdAt         DateTime @default(now())

  @@index([equipmentAssetId])
  @@index([date])
}

// 8. Cron Logs
model CronJobLog {
  id          String    @id @default(cuid())
  jobName     String
  startedAt   DateTime
  completedAt DateTime?
  status      String
  error       String?

  @@index([jobName])
  @@index([startedAt])
}

// 9. Report Job Queue
model ReportJob {
  id            String          @id @default(cuid())
  reportType    String          
  exportFormat  String          
  requestedById String
  requestedBy   User            @relation("ReportRequests", fields: [requestedById], references: [id])
  status        ReportJobStatus @default(PENDING)
  filters       Json?           
  storageKey    String?         
  errorMessage  String?         
  requestedAt   DateTime        @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([requestedById])
  @@index([status])
  @@index([requestedAt])
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}